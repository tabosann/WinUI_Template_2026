<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinUI_Template_2026.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUI_Template_2026"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WinUI_Template_2026">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="48,5*,5*" Background="Transparent">
        <TitleBar Title="{x:Bind AppWindow.Title}"/>
        <Grid Grid.Row="1" ColumnDefinitions="5*,5*">
            <Grid Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefault}"/>
            <Grid Grid.Column="1"/>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="5*,5*">
            <Grid Grid.Column="0"/>
            <Grid Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefault}"/>
        </Grid>
    </Grid>
</Window>
